<Project Sdk="Microsoft.NET.Sdk">
    <!--
      A00 diagnostic harness. Loaded only by tools/authority/run-authority-instance.ps1 into an
      isolated portable game directory. Never ships: output goes to the git-ignored
      TestResults/authority/harness/ instead of the release plugin directory.
    -->
    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
        <OutputPath>$(MSBuildThisFileDirectory)..\..\..\TestResults\authority\harness\</OutputPath>
        <AssemblyName>AuthorityBaseline</AssemblyName>
        <RootNamespace>AuthorityBaseline</RootNamespace>
        <Nullable>disable</Nullable>
        <EnableNETAnalyzers>false</EnableNETAnalyzers>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\..\NebulaPatcher\NebulaPatcher.csproj" />
    </ItemGroup>
</Project>
