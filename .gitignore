# Nebula (Dyson Sphere Program multiplayer mod) — project-specific ignores

# Local dev environment: Steam/DSP install paths (template: DevEnv.targets.example)
DevEnv.targets

# Build / publish outputs (each project has a local dist/ for compile checks)
dist/
*.binlog
# CI build indicator: present => build output goes to dist/
.remoteBuild

# Local helper scripts
/scripts/

# Local decompiled-game reference sources (game code must not be committed)
/reference/

# ZCode workspace
.zcode/
.zcodeignore

# ---- .NET build output ----
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/
*.log
*.tmp
*.pdb
*.[Cc]ache

# ---- IDE / editor ----
.vs/
.idea/
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# ---- Tests / coverage ----
[Tt]est[Rr]esult*/
TestResult.xml
nunit-*.xml
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# ---- NuGet ----
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets

# ---- Node / Python tooling ----
node_modules/
__pycache__/
*.pyc

# ---- Unity ----
# Unity .meta files are re-included inside NebulaUnity via NebulaUnity/.gitignore.
# NOTE: keep these as whole-directory excludes; using dir/* would let the deeper
# !/[Aa]ssets/**/*.meta rule re-include the build-output .meta files inside them.
*.meta
NebulaUnity/Assets/Assemblies
NebulaUnity/Assets/StreamingAssets/AssetBundles
NebulaUnity/Assets/Plugins/Editor/JetBrains
NebulaUnity/Assets/Plugins/Editor/JetBrains.meta
NebulaUnity/Assets/Plugins.meta
NebulaUnity/Assets/Plugins

# ---- Nerdbank.GitVersioning prepare-release ----
.store/
nbgv.exe
