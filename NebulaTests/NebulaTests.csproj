<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="15.3.0"/>
        <PackageReference Include="MSTest.TestFramework" Version="4.0.*"/>
        <PackageReference Include="MSTest.TestAdapter" Version="4.0.*"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\NebulaModel\NebulaModel.csproj" />
      <ProjectReference Include="..\NebulaNetwork\NebulaNetwork.csproj" />
      <ProjectReference Include="..\NebulaPatcher\NebulaPatcher.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Transpiler tests inspect game types; real method bodies can be supplied by the verification script. -->
        <PackageReference Update="DysonSphereProgram.GameLibs" IncludeAssets="compile;runtime" Condition="'$(UseInstalledGameAssemblies)' != 'true'" />
        <Reference Update="Assembly-CSharp" Private="true" Condition="'$(UseInstalledGameAssemblies)' == 'true'" />
        <Reference Update="UnityEngine.UI" Private="true" Condition="'$(UseInstalledGameAssemblies)' == 'true'" />
        <PackageReference Update="UnityEngine.Modules" IncludeAssets="compile;runtime" />
        <!-- The test runner does not have BepInEx's runtime assemblies preloaded. -->
        <PackageReference Update="BepInEx.Core" ExcludeAssets="build" />
    </ItemGroup>

    <Target Name="CopyInstalledUnityRuntime" AfterTargets="Build"
            Condition="'$(UseInstalledGameAssemblies)' == 'true'">
        <Copy SourceFiles="$(DSPGameDir)DSPGAME_Data\Managed\UnityEngine.CoreModule.dll"
              DestinationFolder="$(TargetDir)" />
    </Target>

</Project>
